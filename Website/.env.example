# Main FreedomBot app (Sign in button + post-onboarding handoff).
NEXT_PUBLIC_APP_URL=https://freedombot-core.cloud.cepoch.com

# Optional public signup API (falls back to local demo flow when unset).
NEXT_PUBLIC_API_URL=http://localhost:8001

# FreedomBot API the website's server calls to create the workspace after payment (server-only).
FREEDOMBOT_API_URL=http://localhost:8001
# Same value as SELF_SERVE_SIGNUP_KEY on the FreedomBot server. Never prefix with NEXT_PUBLIC_.
SELF_SERVE_SIGNUP_KEY=
