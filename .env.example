# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# "dev" relaxes auth for local work. Anything else (including unset) is treated
# as production: JWT auth is required and JWT_SECRET must be set.
RUNTIME_ENV=dev

# Public origin of this AgentOS. Used for scheduler callbacks and MCP OAuth.
AGENTOS_URL=http://127.0.0.1:8000

# Browser origins allowed to call the API (the UI).
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_DRIVER=postgresql+psycopg
DB_HOST=localhost
DB_PORT=5432
DB_USER=bizos
DB_PASS=bizos

# Control plane: client registry, users, roles, domain catalogue.
# Holds tenant METADATA only — never customer content.
CONTROL_DB_NAME=bizos_control
# Full URL override; wins over the DB_* parts above when set.
# CONTROL_DB_URL=postgresql+psycopg://user:pass@host:5432/bizos_control

# How new clients are isolated: DEDICATED_DB (own database, Phase 1 default)
# or DEDICATED_SCHEMA (own schema inside SHARED_WORKSPACE_DB).
DEFAULT_DEPLOYMENT_TYPE=DEDICATED_DB
WORKSPACE_DB_PREFIX=bizos_ws_
SHARED_WORKSPACE_DB=bizos_workspaces

# The DB_USER must hold CREATEDB to provision DEDICATED_DB workspaces.

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# REQUIRED in production. Minimum 32 bytes. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=43200
# Send the session cookie with Secure. Defaults to on outside dev.
COOKIE_SECURE=false

# Shared secret AgentOS's scheduler uses to call back into the OS.
INTERNAL_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# Platform defaults
# ---------------------------------------------------------------------------
# Execution mode a newly provisioned client starts in.
# ADVISE | DRAFT | WAIT_FOR_APPROVAL | AUTO_WITHIN_SCOPE
DEFAULT_EXECUTION_MODE=WAIT_FOR_APPROVAL

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Required for chat and for LLM-backed workflow steps. Everything else
# (policy, approvals, memory, audit, connectors) works without it.
OPENAI_API_KEY=
MODEL_ID=openai:gpt-4.1-mini

# ---------------------------------------------------------------------------
# Workspace secret encryption
# ---------------------------------------------------------------------------
# Key-encryption key for the per-workspace `secrets` table. 32+ bytes.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Optional integrations (Phase 1 ships mock adapters; these enable live ones)
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
