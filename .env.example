# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# "dev" relaxes auth for local work. Anything else (including unset) is treated
# as production: JWT auth is required and JWT_SECRET must be set.
RUNTIME_ENV=dev

# Public origin of this AgentOS. Used for scheduler callbacks and MCP OAuth.
AGENTOS_URL=http://127.0.0.1:8000

# Browser origins allowed to call the API (the UI).
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_DRIVER=postgresql+psycopg
DB_HOST=localhost
DB_PORT=5432
DB_USER=bizos
DB_PASS=bizos

# Control plane: client registry, users, roles, domain catalogue.
# Holds tenant METADATA only — never customer content.
CONTROL_DB_NAME=bizos_control
# Full URL override; wins over the DB_* parts above when set.
# CONTROL_DB_URL=postgresql+psycopg://user:pass@host:5432/bizos_control

# How new clients are isolated: DEDICATED_DB (own database, Phase 1 default)
# or DEDICATED_SCHEMA (own schema inside SHARED_WORKSPACE_DB).
DEFAULT_DEPLOYMENT_TYPE=DEDICATED_DB
WORKSPACE_DB_PREFIX=bizos_ws_
SHARED_WORKSPACE_DB=bizos_workspaces

# The DB_USER must hold CREATEDB to provision DEDICATED_DB workspaces.

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# REQUIRED in production. Minimum 32 bytes. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=43200
# Send the session cookie with Secure. Defaults to on outside dev.
COOKIE_SECURE=false

# Shared secret AgentOS's scheduler uses to call back into the OS.
INTERNAL_SERVICE_TOKEN=

# Checkout/contract → assessment handoff (FB-043). Header: X-FreedomBot-Sale-Secret.
SALE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Platform defaults
# ---------------------------------------------------------------------------
# Execution mode a newly provisioned client starts in.
# ADVISE | DRAFT | WAIT_FOR_APPROVAL | AUTO_WITHIN_SCOPE
DEFAULT_EXECUTION_MODE=WAIT_FOR_APPROVAL

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Required for chat and for LLM-backed workflow steps. Everything else
# (policy, approvals, memory, audit, connectors) works without it.
OPENAI_API_KEY=
MODEL_ID=openai:gpt-4.1-mini
# Ops (v2) model. Leave empty to follow MODEL_ID. Campaign always uses MODEL_ID.
EXECUTOR_MODEL_ID=
ROUTER_MODEL_ID=
# Meaning-based memory search: on (default) or off. Needs pgvector and OPENAI_API_KEY.
MEMORY_VECTOR_SEARCH=on
EMBEDDING_MODEL_ID=
# Background sync of each user's Gmail, Calendar, YouTube and HubSpot (Composio): on|off, seconds between runs.
INTEGRATION_SYNC_ENABLED=on
INTEGRATION_SYNC_INTERVAL_SEC=300
# Ops (v2) executor reasoning for reasoning models only (low|medium|high). Empty = off.
EXECUTOR_REASONING_EFFORT=
# Web research (web_search). Tavily gives agent-ready results; empty falls back to DuckDuckGo.
TAVILY_API_KEY=
# Some chat models (e.g. gpt-6-luna) accept function tools only with reasoning effort "none".
# Leave empty to omit the setting; if the provider rejects the configured value the assistant
# retries with "none" and then without it.
MODEL_REASONING_EFFORT=
# unified (default): one Agno assistant for company tasks AND outbound campaigns.
# legacy: the previous per-domain agent (no campaign flow).
ASSISTANT_ENGINE=unified
# On: company chat uses app/assistant/v2.py. Off: every turn uses assistant.py.
# The chat Acquisition toggle still pins admin turns to assistant.py either way.
AGENT_PIPELINE_V2=1

# Apollo people search (Engine & AI → Prospecting rules → Test search). Search only.
# Never commit a real key. The app reads this from the environment, not the database.
APOLLO_API_KEY=

# People Data Labs person search (Engine & AI → Prospecting rules → PDL test search).
# Search only; each returned record costs 1 credit. Never commit a real key.
PDL_API_KEY=

# ---------------------------------------------------------------------------
# Acquisition (Overview, Prospects, Outreach, Settings pages; served at /acquire)
# ---------------------------------------------------------------------------
# Own database on the same Postgres server. docker compose creates and migrates it.
DATABASE_URL=postgresql+psycopg://bizos:bizos@localhost:5432/acquisition
ACQUISITION_URL_PREFIX=/acquire
# Public origin used in assessment links inside emails. Set the real one in production.
PUBLIC_BASE_URL=http://localhost:3000
# Acquisition admin sign-in (hash with: python -c "import bcrypt;print(bcrypt.hashpw(b'pw',bcrypt.gensalt()).decode())")
ADMIN_USERNAME=jeanne
ADMIN_PASSWORD_HASH=
ACQUISITION_SECRET_KEY=
INTEGRATION_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Workspace secret encryption
# ---------------------------------------------------------------------------
# Key-encryption key for the per-workspace `secrets` table. 32+ bytes.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Optional integrations (Phase 1 ships mock adapters; these enable live ones)
# ---------------------------------------------------------------------------
# Composio: lets each user connect their own Gmail / Google Calendar from the
# Integrations page so chat answers from their real inbox and meetings.
# COMPOSIO_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
